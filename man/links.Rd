# Stage 2: Exact match on forename
stages <- as.list(dfr[c("surname", "forename")])
p1 <- links(criteria = stages)

# Reverse the order
# Stage 1: Exact match on forename
# Stage 2: Exact match on surname
p2 <- links(criteria = rev(stages))

